{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coding Companion runtime control envelope 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "project_id",
    "operation",
    "args",
    "created_at",
    "deadline_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "operation": {
      "enum": [
        "check",
        "status",
        "findings",
        "inspect",
        "verify",
        "report",
        "memory_search",
        "challenges",
        "stop",
        "discover",
        "plan",
        "get_run",
        "feedback",
        "suppress",
        "unsuppress",
        "withdraw",
        "maintenance",
        "ack"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "args": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "scope": {
          "enum": [
            "project",
            "changed",
            "selected"
          ]
        },
        "reuse": {
          "type": "boolean"
        },
        "since": {
          "type": "integer",
          "minimum": 0
        },
        "finding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "lesson": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "actor": {
          "enum": [
            "all",
            "coding_agent",
            "companion",
            "user",
            "external_tool"
          ]
        },
        "outcome": {
          "enum": [
            "resolved",
            "acknowledged",
            "investigating",
            "fixing",
            "dismissed",
            "accepted-risk"
          ]
        },
        "suppression_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "kind": {
          "enum": [
            "finding",
            "challenge",
            "lesson"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 1000
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "status",
              "report",
              "stop",
              "discover"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "check"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "propertyNames": {
              "enum": [
                "checks",
                "scope",
                "reuse"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "plan"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "propertyNames": {
              "enum": [
                "checks",
                "scope"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "findings"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "propertyNames": {
              "enum": [
                "since"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "inspect"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "required": [
              "finding_id"
            ],
            "propertyNames": {
              "enum": [
                "finding_id"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "verify"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "required": [
              "finding_id"
            ],
            "propertyNames": {
              "enum": [
                "finding_id",
                "lesson"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "get_run"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "required": [
              "run_id"
            ],
            "propertyNames": {
              "enum": [
                "run_id"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "memory_search"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "required": [
              "query"
            ],
            "propertyNames": {
              "enum": [
                "query"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "challenges"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "propertyNames": {
              "enum": [
                "actor"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "feedback"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "required": [
              "finding_id",
              "outcome"
            ],
            "propertyNames": {
              "enum": [
                "finding_id",
                "outcome",
                "reason"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "suppress"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "required": [
              "finding_id",
              "reason"
            ],
            "propertyNames": {
              "enum": [
                "finding_id",
                "reason",
                "expires_at"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "unsuppress"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "required": [
              "suppression_id"
            ],
            "propertyNames": {
              "enum": [
                "suppression_id"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "withdraw"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "required": [
              "kind",
              "entity_id"
            ],
            "propertyNames": {
              "enum": [
                "kind",
                "entity_id"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "maintenance"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "ack"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "required": [
              "since"
            ],
            "propertyNames": {
              "enum": [
                "since"
              ]
            }
          }
        }
      }
    }
  ]
}
